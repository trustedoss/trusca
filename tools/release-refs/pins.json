{
  "_about": "Places that must carry the current release version. Tag-shaped refs into this repository are found by pattern (see lint.mjs); this file lists the bare version literals a pattern cannot tell apart from any other number. Each entry captures the version in group 1.",
  "pins": [
    {
      "file": "charts/trustedoss/Chart.yaml",
      "pattern": "^version: (\\d+\\.\\d+\\.\\d+)$",
      "note": "chart packaging version, kept in lock-step with the app"
    },
    {
      "file": "charts/trustedoss/Chart.yaml",
      "pattern": "^appVersion: \"(\\d+\\.\\d+\\.\\d+)\"$",
      "note": "released container image tag"
    },
    {
      "file": "charts/trustedoss/values.yaml",
      "pattern": "^  tag: \"(\\d+\\.\\d+\\.\\d+)\"$",
      "note": "image.tag default a chart install pulls"
    },
    {
      "file": "README.md",
      "pattern": "release-v(\\d+\\.\\d+\\.\\d+)-",
      "note": "release badge on the repository front page"
    },
    {
      "file": "docs-site/docs/installation/helm.md",
      "pattern": "chart version \\*\\*(\\d+\\.\\d+\\.\\d+)\\*\\*",
      "note": "prose statement of the chart version"
    },
    {
      "file": "docs-site/docs/installation/helm.md",
      "pattern": "^\\| `image\\.tag` \\| `(\\d+\\.\\d+\\.\\d+)` \\|",
      "note": "values table default"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/installation/helm.md",
      "pattern": "차트 버전 \\*\\*(\\d+\\.\\d+\\.\\d+)\\*\\*",
      "note": "KO mirror of the prose statement"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/installation/helm.md",
      "pattern": "^\\| `image\\.tag` \\| `(\\d+\\.\\d+\\.\\d+)` \\|",
      "note": "KO mirror of the values table default"
    },
    {
      "file": "docs-site/docs/ci-integration/github-actions.md",
      "pattern": "# v(\\d+\\.\\d+\\.\\d+)$",
      "note": "comment naming the release the pinned commit SHA belongs to"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/ci-integration/github-actions.md",
      "pattern": "# v(\\d+\\.\\d+\\.\\d+)$",
      "note": "KO mirror of the pinned-SHA comment"
    },
    {
      "file": "docs-site/docs/ci-integration/gitlab-ci.md",
      "pattern": "release tag \\(`v(\\d+\\.\\d+\\.\\d+)`\\)",
      "note": "prose naming the tag to pin the include URL to"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/ci-integration/gitlab-ci.md",
      "pattern": "릴리스 태그\\(`v(\\d+\\.\\d+\\.\\d+)`\\)",
      "note": "KO mirror of the prose naming the pin tag"
    },
    {
      "file": ".env.example",
      "pattern": "^IMAGE_TAG=(\\d+\\.\\d+\\.\\d+)$",
      "note": "image tag a fresh compose install pulls (install.sh copies this file to .env)"
    },
    {
      "file": "docker-compose.yml",
      "pattern": "\\$\\{IMAGE_TAG:-(\\d+\\.\\d+\\.\\d+)\\}",
      "note": "fallback used when .env carries no IMAGE_TAG"
    },
    {
      "file": "scripts/bundle-offline.sh",
      "pattern": "\\$\\{IMAGE_TAG:-(\\d+\\.\\d+\\.\\d+)\\}",
      "note": "offline bundle tag when neither --tag nor .env sets one"
    },
    {
      "file": "scripts/bundle-offline.sh",
      "pattern": "default: from \\.env, else (\\d+\\.\\d+\\.\\d+)\\)",
      "note": "usage text stating that fallback"
    },
    {
      "file": "docs-site/docs/installation/docker-compose.md",
      "pattern": "defaults to (\\d+\\.\\d+\\.\\d+)\\)",
      "note": "stated IMAGE_TAG default in the quick-install comment"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/installation/docker-compose.md",
      "pattern": "기본값 (\\d+\\.\\d+\\.\\d+)\\)",
      "note": "KO mirror of the stated IMAGE_TAG default"
    },
    {
      "file": "docs-site/docs/admin-guide/offline-install.md",
      "pattern": "--tag (\\d+\\.\\d+\\.\\d+) --registry",
      "note": "bundle command a reader copies"
    },
    {
      "file": "docs-site/docs/admin-guide/offline-install.md",
      "pattern": "trusca-offline-bundle-(\\d+\\.\\d+\\.\\d+)\\.tar",
      "note": "bundle file name the install commands load"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/admin-guide/offline-install.md",
      "pattern": "--tag (\\d+\\.\\d+\\.\\d+) --registry",
      "note": "KO mirror of the bundle command"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/admin-guide/offline-install.md",
      "pattern": "trusca-offline-bundle-(\\d+\\.\\d+\\.\\d+)\\.tar",
      "note": "KO mirror of the bundle file name"
    },
    {
      "file": "docs-site/docs/ci-integration/release-verification.md",
      "pattern": "^VERSION=(\\d+\\.\\d+\\.\\d+) ",
      "note": "release the verification walkthrough resolves"
    },
    {
      "file": "docs-site/docs/ci-integration/release-verification.md",
      "pattern": "^git verify-tag v(\\d+\\.\\d+\\.\\d+)$",
      "note": "tag the signature check verifies"
    },
    {
      "file": "docs-site/docs/admin-guide/vulnerability-data.md",
      "pattern": "trusca-backend-worker:(\\d+\\.\\d+\\.\\d+) \\\\",
      "note": "worker image the offline Trivy DB export runs"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/ci-integration/release-verification.md",
      "pattern": "^VERSION=(\\d+\\.\\d+\\.\\d+) ",
      "note": "KO mirror: release the verification walkthrough resolves"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/ci-integration/release-verification.md",
      "pattern": "^git verify-tag v(\\d+\\.\\d+\\.\\d+)$",
      "note": "KO mirror: tag the signature check verifies"
    },
    {
      "file": "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/admin-guide/vulnerability-data.md",
      "pattern": "trusca-backend-worker:(\\d+\\.\\d+\\.\\d+) \\\\",
      "note": "KO mirror: worker image the offline Trivy DB export runs"
    }
  ],
  "_pending_about": "Pins that belong in `pins` but whose files are held by other work in flight. On a PR the linter prints them as a notice and does not fail on them; `--release` fails while any remain. An entry parked here is a default nothing checks, which is how .env.example and docker-compose.yml still named 0.22.0 and 0.12.0 after v0.23.0 shipped.",
  "pending": [],
  "_exclude_about": "Files whose tag-shaped refs are history, not instructions. A reader is not meant to run them against today's release.",
  "exclude": [
    "CHANGELOG.md",
    "docs-site/docs/release-notes/",
    "docs-site/i18n/ko/docusaurus-plugin-content-docs/current/release-notes/",
    "tools/release-refs/"
  ]
}
