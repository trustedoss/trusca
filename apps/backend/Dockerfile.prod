# TrustedOSS Portal — backend (production image).
#
# Goals vs. the dev Dockerfile:
#   - Multi-stage so the runtime image doesn't carry build-essential / gcc.
#   - Production deps only, hash-pinned (`requirements.lock`, generated from
#     `requirements.txt`; no `requirements-dev.txt`).
#   - No `--reload`, multiple uvicorn workers (`--workers`, default 4,
#     runtime-configurable via `UVICORN_WORKERS`, see the CMD comment below).
#   - `tini` as PID 1 so SIGTERM propagates cleanly when docker stops the container.
#   - Non-root runtime user (uid 1000) — least privilege.
#
# CLAUDE.md core rule #9: pin tags + minor + patch, no `:latest`.

# ---------- 1. build ----------
FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS build

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build-time deps for psycopg2 (alembic) and any C extensions.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# requirements.lock (pip-compile --generate-hashes, from requirements.txt)
# is what actually gets installed: every direct AND transitive dependency
# pinned to an exact version with its wheel/sdist hash, so a build cannot
# silently pick up a newer transitive release, and `--require-hashes` makes
# pip refuse to install anything this file does not cover.
COPY requirements.lock /app/
RUN pip install --upgrade pip \
    && pip install --require-hashes --prefix=/install -r requirements.lock

# ---------- 2. runtime ----------
FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS runtime

# The release build passes the tag here so the running image can state its
# own version — SLSA provenance, the About surface and every SBOM we emit
# read it. Unset it stays "unknown", which is what the 2026 SBOM minimum
# elements ask for when no version identifier is available; a plausible
# looking default would be a false statement in three places.
ARG TRUSTEDOSS_VERSION=unknown
ENV TRUSTEDOSS_VERSION=${TRUSTEDOSS_VERSION}

# O11 (observability gap plan): the commit and build timestamp, same
# mechanism and same "unknown" default reasoning as TRUSTEDOSS_VERSION
# above. There is no other way for a running container to learn either
# value; both feed the trusca_build_info metric and the About screen.
ARG TRUSTEDOSS_COMMIT=unknown
ENV TRUSTEDOSS_COMMIT=${TRUSTEDOSS_COMMIT}
ARG TRUSTEDOSS_BUILT_AT=unknown
ENV TRUSTEDOSS_BUILT_AT=${TRUSTEDOSS_BUILT_AT}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Runtime libs only — libpq for psycopg, curl for the healthcheck, tini for
# PID 1 signal handling.
#
# weasyprint (scan-gap G2 — vulnerability PDF report) dlopen's its native
# rendering libs at runtime: pango (pulls cairo + harfbuzz), gdk-pixbuf and
# a default font face. These belong in the runtime stage (weasyprint ships as
# pure-Python wheels, so the build stage needs no extra packages).
# `apt-get upgrade -y` patches every installed OS package to whatever the
# apt index resolves at build time (mirrors Dockerfile.worker's ci.yml
# image-scan gate reasoning) — a release built weeks after this layer last
# changed would otherwise still ship the packages `python:3.12.14-slim-
# bookworm` was baked with on release day, not what Debian's security
# channel has shipped since. release.yml's weekly cache-scope rotation
# (mirroring ci.yml's image-scan job) bounds the resulting drift to a week.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
        tini \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz-subset0 \
        libgdk-pixbuf-2.0-0 \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1000 trustedoss \
    && adduser  --system --uid 1000 --gid 1000 --home /app trustedoss

# Pull pre-built site-packages from the build stage; no compiler shipped to prod.
COPY --from=build /install /usr/local

WORKDIR /app

# v2.1 (L3copy) — copy the entrypoint EXPLICITLY, before the broad source
# copy, with an explicit mode. This file is load-bearing (tini ENTRYPOINTs
# into it and it applies Alembic migrations on container start), so we do not
# rely on the broad `COPY . /app` + .dockerignore interaction or a separate
# `RUN chmod` to land it executable. `--chmod=0755` sets the bit at copy time
# regardless of the host file's permissions; `--chown` keeps it owned by the
# non-root runtime user. See apps/backend/docker-entrypoint.sh for the full
# rationale incl. the multi-replica advisory-lock note.
# NOTE: the build context is apps/backend (see release.yml `context:`), so the
# source path here is relative to that — docker-entrypoint.sh, not
# apps/backend/docker-entrypoint.sh.
COPY --chown=trustedoss:trustedoss --chmod=0755 \
     docker-entrypoint.sh /app/docker-entrypoint.sh

# Apache-2.0 §4(a) + §4(d): a distributed artifact must carry the license and
# the attribution notices. The image IS a distribution, so the OCI
# `org.opencontainers.image.licenses` label (release.yml) does not satisfy this
# on its own — the files have to be on the filesystem. `/licenses/` is the
# conventional location (OCI / Red Hat container guidelines).
#
# These are COPIES of the repo-root files, kept in apps/backend/ because the
# build context is apps/backend (release.yml `context:`) and the root is
# therefore out of reach. tests/unit/test_license_distribution.py asserts the
# copies stay byte-identical to the root originals and that every Dockerfile
# ships them — do not edit a copy directly.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /licenses/

# Copy app source (apps/backend/.dockerignore excludes tests/, .pytest_cache,
# scripts/seed_e2e_user.py is excluded too — see security review finding in
# scripts/seed_e2e_user.py for the rationale). The explicit COPY above already
# placed docker-entrypoint.sh with mode 0755; this broad copy re-lands it with
# identical content, so the executable bit and ownership are preserved.
COPY --chown=trustedoss:trustedoss . /app

# Drop privileges before runtime. The non-root user owns /app so alembic
# can write to its tmp staging area at upgrade time.
USER trustedoss

EXPOSE 8000

# Healthcheck mirrors the dev image — backend exposes /health from main.py.
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=30s \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

# tini is PID 1; the entrypoint script runs migrations then `exec`s CMD so
# signals reach uvicorn cleanly. CMD is unchanged — the script runs it via
# `exec "$@"`.
ENTRYPOINT ["/usr/bin/tini", "--", "/app/docker-entrypoint.sh"]
# W1 (concurrency-scaling-plan-2026-08-22.md §3.5): worker count is a
# runtime env var, not a value baked into this image. UVICORN_WORKERS is
# read by /bin/sh at CONTAINER START (this is shell-form CMD wrapped in an
# explicit `sh -c`, not a Dockerfile ARG/ENV substitution done at build
# time), so compose/Helm set it like any other env var (CLAUDE.md rule #11).
# 4 is the default when it is unset, the same "reasonable default for a
# 2-core deployment" this image has always shipped; operators raise it with
# more cores instead of rewriting the whole command. `exec` hands the
# process image to uvicorn directly (same PID chain tini already signals).
CMD ["/bin/sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-4}"]
